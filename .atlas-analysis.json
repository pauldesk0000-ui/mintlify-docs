  "keyFeatures": [
    "Wishes — open-ended ideas with loose timeframes that friends can mark as interested",
    "Plans — date-and-time events with participant capacity that friends can join",
    "Convert a wish into a plan when an idea gains enough momentum",
    "Visibility control — publish events to friends only or friends-of-friends",
    "Friend management with requests, search, and personal invite links",
    "In-app notification feed covering event activity and friend requests",
    "Shareable deep links for events with S3-backed cover images",
    "Google OAuth and email sign-up with verification code",
    "Avatar upload with in-browser cropping",
    "Mobile app (React Native / Expo) for iOS and Android"
  ],
